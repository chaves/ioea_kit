{
	"name": "ioea-sveltekit",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"prebuild": "prisma generate && (npx tsx scripts/generate-program-image.ts all || echo 'PDF conversion skipped (tools not available)')",
		"build": "vite build",
		"preview": "vite preview",
		"start": "node server.js",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"generate-placeholders": "node scripts/generate-placeholders.js",
		"generate-images": "npx tsx scripts/generate-program-image.ts all"
	},
	"devDependencies": {
		"@sveltejs/adapter-auto": "^8.0.0",
		"@sveltejs/adapter-node": "^6.0.1",
		"@sveltejs/kit": "^3.1.1",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@types/nodemailer": "^7.0.12",
		"autoprefixer": "^10.6.2",
		"postcss": "^8.5.32",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.7",
		"tailwindcss": "^3.4.19",
		"tsx": "^4.23.15",
		"typescript": "^6.0.3",
		"vite": "^8.3.5"
	},
	"optionalDependencies": {
		"@img/sharp-darwin-arm64": "^0.34.5",
		"@img/sharp-darwin-x64": "^0.34.5",
		"@img/sharp-linux-x64": "^0.34.5"
	},
	"pnpm": {
		"onlyBuiltDependencies": [
			"@prisma/client",
			"@prisma/engines",
			"esbuild",
			"prisma",
			"sharp"
		]
	},
	"dependencies": {
		"@lucide/svelte": "^1.65.0",
		"@prisma/adapter-mariadb": "^7.10.1",
		"@prisma/client": "^6.19.3",
		"@tiptap/core": "^3.32.1",
		"@tiptap/extension-placeholder": "^3.32.1",
		"@tiptap/pm": "^3.32.1",
		"@tiptap/starter-kit": "^3.32.1",
		"@types/bcryptjs": "^2.4.6",
		"bcryptjs": "^3.0.3",
		"dotenv": "^17.4.2",
		"marked": "^17.0.6",
		"mysql2": "^3.24.6",
		"nodemailer": "^7.0.13",
		"prisma": "^6.19.3",
		"sharp": "^0.34.5",
		"xlsx": "^0.18.5"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"packageManager": "pnpm@10.30.1"
}
